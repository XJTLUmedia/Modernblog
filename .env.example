# ─── Database Configuration ───────────────────────────────────────────────────
# The app auto-detects SQLite vs PostgreSQL from the DATABASE_URL format.
# You can also force a provider with: PRISMA_PROVIDER=sqlite|postgresql

# For local development (SQLite):
DATABASE_URL=file:./prisma/.dev.db

# For production / Vercel Postgres:
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
# DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
#   ↑ DIRECT_URL bypasses connection pooling, used for migrations/db push
# ──────────────────────────────────────────────────────────────────────────────

# Admin Credentials, API keys, comment out if you don't have that
ADMIN_EMAIL=admin@xxx.com
ADMIN_PASSWORD=your_secure_password_here
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key
# If you want to use google search when you write a new blog
GOOGLE_API_KEY=your_google_api_key
GOOGLE_CX=your_google_cx
# If you want to use auth from googleoauth
REPLICATE_API_TOKEN=your_replicate_api_token
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=your_google_redirect_uri